#!/bin/sh
# Refuses a push whose new commits hold a secret, signing material or a real document, or were made under a
# machine-local identity. Enabled by scripts/bootstrap.sh. Git passes "<local ref> <local sha> <remote ref> <remote sha>"
# for each ref being pushed.
set -u

check=$(git rev-parse --show-toplevel)/scripts/check-secrets.sh
zero=0000000000000000000000000000000000000000
remote=$1
status=0
while read -r _ local_sha _ remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # deleting a branch publishes nothing
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha --not --remotes=$remote" # a new branch: whatever the remote does not have yet
  else
    range="$remote_sha..$local_sha"
  fi
  # The range is several git log arguments on purpose.
  # shellcheck disable=SC2086
  "$check" --range $range || status=1
done
exit $status
