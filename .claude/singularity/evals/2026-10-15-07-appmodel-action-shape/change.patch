+    /// Puts `text` on the clipboard, in place of what was there. Whether it did: if the pasteboard would not take it, why is
+    /// shown (`lastError`).
+    @discardableResult
+    func copy(_ text: String) -> Bool {
+        let pasteboard = NSPasteboard.general
+        pasteboard.clearContents()
+        return report(pasteboard.setString(text, forType: .string))
+    }
+
+    /// Puts an answer on the clipboard as plain text without Markdown markers (`AnswerMarkdown.plainText`), and as rich text
+    /// with its emphasis and lists (`RichAnswer`), in place of what was there. Whether it did, as `copy(_:)` says.
+    @discardableResult
+    func copy(answer markdown: String) -> Bool {
+        let pasteboard = NSPasteboard.general
+        pasteboard.clearContents()
+        var wrote = pasteboard.setString(AnswerMarkdown.plainText(markdown), forType: .string)
+        if let rich = RichAnswer.text(of: markdown),
+           let data = try? rich.data(from: NSRange(location: 0, length: rich.length), documentAttributes: [.documentType: NSAttributedString.DocumentType.rtf]) {
+            wrote = pasteboard.setData(data, forType: .rtf) && wrote
+        }
+        return report(wrote)
+    }
+
+    /// Says why a copy failed, as any action that fails is said (`perform`); `wrote` as it was.
+    private func report(_ wrote: Bool) -> Bool {
+        if !wrote {
+            lastError = Wording.failure(Wording.copyAction, Wording.copyRefused)
+            Log.error(.ui, "The pasteboard would not take a copy")
+        }
+        return wrote
     }
 
