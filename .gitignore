/.tools/
.DS_Store
*.dSYM
Tests/Fixtures/private/
.build-*/
.claude

# Signing material and credentials never belong in the repository (scripts/check-secrets.sh enforces it).
*.p12
*.p8
*.cer
*.mobileprovision
*.provisionprofile
*.keychain-db
.env
.env.*
.vscode

# QA findings of a run (docs/qa/protocol.md), left for implementation, never committed.
/docs/qa/reports/

# Findings of a review of the whole project (docs/review/code-review.md), left for implementation, never committed.
/docs/review/reports/
