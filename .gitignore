.build/
.swiftpm/
*.xcodeproj/
# Generated by `xcodegen generate` from the `info` properties in project.yml, their one source.
/App/Info.plist
xcuserdata/
DerivedData/
# Left in the working directory by `swift test --enable-code-coverage`.
*.profraw
build/
dist/
# The pinned tools scripts/tools.sh installs.
/.tools/
.DS_Store
*.dSYM
Tests/Fixtures/private/
.build-*/
# Claude Code: only the shared singularity setup is committed; worktrees and local settings stay on each machine.
.claude/*
!.claude/settings.json
!.claude/singularity.md
!.claude/singularity/
!.claude/rules/
# The singularity pipeline's specs and plans (.agentic/work) and the task files (.agentic/tasks), which can hold
# customer details.
/.agentic/

# Signing material and credentials never belong in the repository (scripts/check-secrets.sh enforces it).
*.p12
*.p8
*.cer
*.mobileprovision
*.provisionprofile
*.keychain-db
.env
.env.*
.vscode

# QA findings of a run (docs/qa/protocol.md), left for implementation, never committed.
/docs/qa/reports/

# Findings of a review of the whole project (docs/review/code-review.md), left for implementation, never committed.
/docs/review/reports/
