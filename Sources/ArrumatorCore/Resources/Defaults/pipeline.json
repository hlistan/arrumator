  "classification": {
    "promptVersion": 2,
    "logicMaxChars": 8000,
    "excerptChars": 12000,
    "embeddingSummaryChars": 2000,
    "embeddingNumCtx": 2048,
    "promptExamplesPerFolder": 3,
    "knn": {
      "k": 24,
      "maxPerFolder": 4,
      "halfLifeDays": 180,
      "recencyFloor": 0.7
    },
    "candidateWeights": {
      "similarity": 0.5,
      "knn": 0.5
    },
    "candidateWeightsNoMemory": {
      "similarity": 1.0,
      "knn": 0.0
    },
    "correspondentStrength": {
      "stableKey": 1.0,
      "domain": 0.9,
      "alias": 0.7,
      "ruleMinimum": 0.9
    },
    "correspondentScanChars": 3000,
    "llmOptions": {
      "temperature": 0,
      "topK": 1,
      "topP": 1,
      "numPredict": 600,
      "seed": 42
    },
    "titleMaxChars": 60,
    "maxTags": 5,
    "vlmNumPredict": 300,
    "promptDatesLimit": 5,
    "promptIdentifiersLimit": 8,
    "alternativesCount": 3,
    "ruleTextScanChars": 20000,
    "repairAttempts": 1,
    "placementGuard": {
      "duplicateAbove": 0.85,
      "offerAbove": 0.6,
      "choices": 4,
      "rankFusionK": 10,
      "maxJudgements": 2,
      "partyAbove": 0.8
