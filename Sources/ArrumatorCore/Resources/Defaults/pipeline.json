{
  "ollama": {
    "appBundleIdentifier": "com.electron.ollama",
    "appBinarySubpath": "Contents/Resources/ollama",
    "binarySearchPaths": [
      "/Applications/Ollama.app",
      "~/Applications/Ollama.app",
      "/opt/homebrew/bin/ollama",
      "/usr/local/bin/ollama"
    ],
    "serveEnvironment": {
      "OLLAMA_HOST": "127.0.0.1:11434",
      "OLLAMA_MAX_LOADED_MODELS": "2"
    },
    "timeouts": {
      "meta": 2,
      "version": 1.5,
      "chat": 180,
      "embed": 60,
      "pull": 0
    },
    "retryDelays": [
      2,
      8,
      30
    ],
    "healthPollStarting": 0.5,
    "healthPollSteady": 30,
    "startTimeout": 30,
    "restartBackoff": [
      5,
      30,
      120,
      600
    ],
    "maxRestartsPerHour": 5,
    "requiredFreeDiskGBAfterPull": 5
  },
  "modelProfiles": {
    "standard": {
      "label": "Standard (ministral-3:14b + bge-m3, ~10 GB)",
      "chatModel": "ministral-3:14b",
      "visionModel": "ministral-3:14b",
      "embedModel": "bge-m3",
      "fastModel": "ministral-3:14b",
      "numCtx": 12288,
      "fastNumCtx": 12288,
      "keepAliveChat": "10m",
      "keepAliveEmbed": "30m",
      "residentBudgetGB": 14
    },
    "balanced": {
      "label": "Balanced (ministral-3:8b + bge-m3, ~7 GB)",
      "chatModel": "ministral-3:8b",
      "visionModel": "ministral-3:8b",
      "embedModel": "bge-m3",
      "fastModel": "ministral-3:8b",
      "numCtx": 12288,
      "fastNumCtx": 12288,
      "keepAliveChat": "10m",
      "keepAliveEmbed": "30m",
      "residentBudgetGB": 14
    },
    "lowMemory": {
      "label": "Low memory (gemma4:e2b + bge-m3, ~5.5 GB)",
      "chatModel": "gemma4:e2b-it-qat",
      "visionModel": "gemma4:e2b-it-qat",
      "embedModel": "bge-m3",
      "fastModel": "gemma4:e2b-it-qat",
      "numCtx": 12288,
      "fastNumCtx": 12288,
      "keepAliveChat": "10m",
      "keepAliveEmbed": "30m",
      "residentBudgetGB": 8
    }
  },
  "watcher": {
    "fsEventsLatency": 1.0,
    "stabilityPollInterval": 2.0,
    "stabilityRequiredPolls": 2,
    "zeroByteWaitSeconds": 30,
    "ignoredNamePrefixes": [
      ".",
      "~$",
      "._"
    ],
    "ignoredNames": [
      "Icon\r",
      ".DS_Store",
      "desktop.ini",
      "Thumbs.db"
    ],
    "ignoredExtensions": [
      "crdownload",
      "part",
      "download",
      "tmp",
      "partial",
      "opdownload"
    ],
    "ignoredNameSubstrings": [
      ".sb-",
      ".arrumator-tmp-"
    ],
    "managedFilePrefix": "_",
    "managedFileExtension": "md",
    "selfChangeTTLSeconds": 30
  },
  "taxonomy": {
    "aboutFileName": "_about.md",
    "documentsFileName": "_documents.md",
    "indexFileName": "_INDEX.md",
    "recentTitlesPerFolder": 5,
    "embeddingExampleLimit": 8,
    "embeddingBodyChars": 1200,
    "learnedExamplesLimit": 8,
    "systemArea": {
      "code": "system",
      "name": "System",
      "description": "Folders the app manages itself; documents here are waiting for a decision."
    },
    "systemFolders": [
      {
        "role": "needsReview",
        "code": "needs-review",
        "name": "Needs review",
        "description": "Documents the app could not file confidently. Moving one into a folder teaches the app."
      },
      {
        "role": "duplicates",
        "code": "duplicates",
        "name": "Duplicates",
        "description": "Byte-identical copies of documents that are already filed; the app's history names the original."
      },
      {
        "role": "learned",
        "code": "learned",
        "name": "Learned",
        "description": "What Arrumator has learned from how you file: senders, rules, corrections and filing memories. The app rebuilds its index from these files."
      },
      {
        "role": "logic",
        "code": "logic",
        "name": "Logic",
        "description": "How this archive is organised: the logic the model follows when it files documents here. The prompt is the text of _logic.md; edit it in the app or in any editor."
      },
      {
        "role": "history",
        "code": "history",
        "name": "History",
        "description": "Everything that happened, one file per month."
      }
    ],
    "maxDepth": 8,
    "learnedCorrespondentsLimit": 5,
    "prunableLeftovers": [
      ".DS_Store",
      ".localized",
      "Icon\r"
    ]
  },
  "records": {
    "sendersFileName": "_senders.md",
    "rulesFileName": "_rules.md",
    "correctionsFileName": "_corrections.md",
    "memoriesFileName": "_memories.md",
    "logicFileName": "_logic.md",
    "setAsideSuffix": "unreadable"
  },
  "ingest": {
    "maxAttempts": 3,
    "retryDelays": [
      2,
      8,
      30
    ],
    "watchdogMinutes": 10
  },
  "extraction": {
    "languages": [
      "en",
      "ru",
      "pt"
    ],
    "languageSampleChars": 4000,
    "languageMinConfidence": 0.5,
    "maxIndexChars": 200000,
    "largeFileBytes": 524288000,
    "perFileTimeout": 180,
    "toolTimeout": 30,
    "toolOutputCapBytes": 20971520,
    "plainTextReadCapBytes": 10485760,
    "pdf": {
      "textLayerHeadPages": 200,
      "textLayerTailPages": 5,
      "ocrHeadPages": 5,
      "ocrAllIfAtMost": 6,
      "ocrDPI": 200,
      "ocrDPILargePage": 150,
      "ocrDPISmallPage": 300,
      "largePageArea": 1400000,
      "smallPageArea": 87000,
      "minPageChars": 40,
      "minLetterShare": 0.35,
      "maxReplacementShare": 0.02,
      "imagePageMaxChars": 200,
      "orientationRetryBelowConfidence": 0.4,
      "ocrPageTimeout": 20,
      "fullPageImageCoverage": 0.85,
      "ocrMaxPixel": 5000
    },
    "image": {
      "ocrMaxPixel": 2048,
      "vlmMaxPixel": 1024,
      "jpegQuality": 0.8,
      "sparseChars": 80,
      "sparseWords": 8,
      "lowConfidence": 0.35,
      "vlmTimeout": 90
    },
    "ocr": {
      "lowConfidenceLine": 0.5,
      "lowConfidenceWarning": 0.4,
      "contrast": 1.3
    },
    "csvMaxRows": 200,
    "xlsx": {
      "maxSheets": 20,
      "maxRows": 300,
      "maxColumns": 30
    },
    "pptxMaxSlides": 100,
    "archiveMaxEntries": 200,
    "emailBodyCapBytes": 5242880,
    "quickLookPixel": 2048,
    "tableSnippetChars": 2000,
    "maxTables": 3,
    "candidateEncodings": [
      "utf8",
      "windowsCP1251",
      "koi8R",
      "macCyrillic",
      "isoLatin1",
      "windowsCP1252",
      "macOSRoman"
    ],
    "cyrillicBigramMinShare": 0.1,
    "toolKillGrace": 2,
    "zipEntryCapBytes": 20971520,
    "emailMaxPartDepth": 12,
    "tracePreviewChars": 200
  },
  "entities": {
    "dateLabels": [
      "date",
      "dated",
      "invoice date",
      "issue date",
      "issued",
      "data",
      "data de emissão",
      "emitido em",
      "data do documento",
      "дата",
      "дата документа",
      "дата выдачи",
      "от"
    ],
