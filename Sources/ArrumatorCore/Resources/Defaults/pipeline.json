  },
  "calibration": {
    "weights": {
      "llm": 0.45,
      "knn": 0.25,
      "similarity": 0.1,
      "ideal": 0.2
    },
    "weightsNoMemory": {
      "llm": 0.6,
      "knn": 0.0,
      "similarity": 0.1,
      "ideal": 0.3
    },
    "ruleAgreeFloor": 0.9,
    "ruleAgreeBonus": 0.05,
    "ruleConflictPenalty": -0.3,
    "metadataOnlyPenalty": -0.2,
    "metadataOnlyCap": 0.6,
    "vlmOnlyCap": 0.7,
    "lowOCRThreshold": 0.5,
    "lowOCRPenalty": -0.1,
    "mtimeDatePenalty": -0.05,
    "unknownLanguagePenalty": -0.05,
    "newFolderConfidenceScale": 0.9,
    "similarityFloor": 0.45,
    "similarityCeiling": 0.8,
    "idealFloor": 0.5,
    "idealCeiling": 0.9
  },
  "learning": {
    "memoryWeights": {
      "auto": 0.5,
      "approved": 1.0,
      "corrected": 1.5,
      "unconfirmed": 0.25
    },
    "maxMemoriesPerFolder": 500,
    "ruleMinSupport": 3,
    "ruleMaxContradictionShare": 0.2,
    "ruleStrictBelowSupport": 5,
    "ruleDisableAfterContradictions": 2,
    "ruleReenableReliability": 0.9,
    "ruleInducedPriority": 50,
    "correspondentRuleMinSupport": 5,
    "correspondentRulePriority": 80,
    "stableKeyMinFilings": 2,
    "defaultFolderMinWins": 3,
    "descriptionRefresh": {
      "minNewDocuments": 10,
      "intervalDays": 7,
      "sampleSize": 30,
      "excerptSamples": 10,
      "excerptChars": 300,
      "temperature": 0.2,
      "exampleCount": 3
    },
    "absorbSampleFiles": 10,
    "directPlacement": {
      "ruleMinReliability": 0.9,
      "knnMinSimilarity": 0.92,
      "knnMinNeighbors": 1,
      "typeEstimateMinNeighbors": 1
    },
    "trustedMemoryMinWeight": 0.5,
    "settleUnconfirmedAfterDays": 14
  },
  "naming": {
    "maxChars": 120,
    "maxBytes": 250,
    "forbiddenCharacters": [
      "/",
      ":",
      "\\"
    ],
    "collisionFormat": " (%d)"
  },
  "search": {
    "rrfK": 60,
    "ftsCandidateLimit": 200,
    "resultLimit": 50,
    "minSemanticQueryChars": 3,
    "semanticMinSimilarity": 0.56,
    "queryCacheSize": 256,
    "bm25Weights": [
      5,
      3,
      2,
      1
    ],
    "snippetTokens": 24,
    "debounceMilliseconds": 150,
    "vectorSnippetChars": 200
  },
  "logging": {
    "keepDays": 14,
    "maxBytes": 209715200,
    "bufferLimit": 5000
  },
  "power": {
    "pauseBelowBatteryPercent": 20,
    "pauseAtThermalState": "serious",
    "recheckSeconds": 60
  },
  "stats": {
    "windowsDays": [
      7,
      30,
      90
    ],
    "whatIfAutoThresholds": [
      0.6,
      0.65,
      0.7,
      0.75,
      0.8,
      0.85,
      0.9,
      0.95
    ],
    "folderOverlapSimilarity": 0.9,
    "confusionPairsLimit": 20,
    "diagnosticsTraceLimit": 200,
    "funnel": {
      "trendBuckets": 8,
      "minimumForShares": 20,
      "steps": [
        {
          "id": "arrived",
          "title": "Arrived",
          "detail": "A new file settled in the Incoming folder.",
          "stages": [
            "stability",
            "hash"
          ],
          "logCategories": [
            "watch",
            "fileops"
          ],
          "jobStates": [
            "pending"
          ]
        },
        {
          "id": "deduplicated",
          "title": "Checked for copies",
          "detail": "Compared against everything already filed.",
          "stages": [
            "dedupe"
          ],
          "logCategories": [
            "ingest"
          ],
          "jobStates": [
            "hashing"
          ]
        },
        {
          "id": "read",
          "title": "Read",
          "detail": "Text pulled from the file, scanning pages when there is no text layer.",
          "stages": [
            "extract",
            "ocr",
            "vlm"
          ],
          "logCategories": [
            "extract"
          ],
          "jobStates": [
            "extracting"
          ]
        },
        {
          "id": "understood",
          "title": "Understood",
          "detail": "Dates, identifiers and the correspondent picked out of the text.",
          "stages": [
            "entities",
            "correspondent"
          ],
          "logCategories": [
            "extract",
            "classify"
          ],
          "jobStates": [
            "extracting"
          ]
        },
        {
          "id": "matched",
          "title": "Matched against what it knows",
          "detail": "Learned rules, past filings and folder descriptions consulted.",
          "stages": [
            "rules",
            "embed",
            "candidates"
          ],
          "logCategories": [
            "classify",
            "learn"
          ],
          "jobStates": [
            "classifying"
          ]
        },
        {
          "id": "decided",
          "title": "Decided",
          "detail": "A folder and a file name chosen, by a learned rule or by the local model.",
          "stages": [
            "llm",
            "judge",
            "validate",
            "calibrate"
          ],
          "logCategories": [
            "ollama",
            "classify"
          ],
          "jobStates": [
            "classifying"
          ]
        },
        {
          "id": "filed",
          "title": "Filed",
          "detail": "Renamed, moved into the archive and added to the search index.",
          "stages": [
            "name",
            "place",
            "index"
          ],
          "logCategories": [
            "fileops",
            "index",
            "taxonomy"
          ],
          "jobStates": [
            "filing"
          ]
        },
        {
          "id": "learned",
          "title": "Learned from",
          "detail": "The placement was remembered so the next similar file needs no model.",
          "stages": [
            "learn"
          ],
          "logCategories": [
            "learn"
          ],
          "jobStates": []
        }
      ]
    }
  },
  "interface": {
