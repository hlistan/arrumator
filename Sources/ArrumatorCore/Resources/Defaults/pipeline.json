    "funnel": {
      "minimumForShares": 20,
      "steps": [
        {
          "id": "arrived",
          "title": "Arrived",
          "detail": "A new file settled in the Incoming folder; one put in a folder there was given the folder's name as a tag.",
          "stages": [
            "hash",
            "tag"
          ],
          "logCategories": [
            "watch",
            "fileops"
          ],
          "jobStates": [
            "pending"
          ]
        },
        {
          "id": "deduplicated",
          "title": "Checked for copies",
          "detail": "Compared against everything in the archive: an exact copy has the document it copies read again instead.",
          "stages": [
            "dedupe"
          ],
          "logCategories": [
            "ingest"
          ],
          "jobStates": [
            "hashing"
          ]
        },
        {
          "id": "read",
          "title": "Read",
          "detail": "Text pulled from the file, scanning pages when there is no text layer.",
          "stages": [
            "extract",
            "ocr",
            "vlm"
          ],
          "logCategories": [
            "extract"
          ],
          "jobStates": [
            "extracting"
          ]
        },
        {
          "id": "understood",
          "title": "Understood",
          "detail": "Dates and identifiers picked out of the text.",
          "stages": [
            "entities"
          ],
          "logCategories": [
            "extract"
          ],
          "jobStates": [
            "extracting"
          ]
        },
        {
          "id": "analysed",
          "title": "Analysed",
          "detail": "The local model read it and gave it its labels and its name, kept one vocabulary with the archive's.",
          "stages": [
            "analyse",
            "consolidate"
          ],
          "logCategories": [
            "ollama",
            "classify"
          ],
          "jobStates": [
            "analysing"
          ]
        },
        {
          "id": "filed",
          "title": "Filed",
          "detail": "Renamed, moved into the archive and added to the search index.",
          "stages": [
            "name",
            "place",
            "embed",
            "index"
          ],
          "logCategories": [
            "fileops",
            "index"
          ],
          "jobStates": [
            "filing"
          ]
        }
      ]
    }
  },
