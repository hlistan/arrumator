      "dob",
      "date of birth",
      "birth",
      "nascimento",
      "data de nascimento",
      "дата рождения"
    ],
    "labelWindowChars": 120,
    "yearsBack": 30,
    "yearsForward": 1,
    "scores": {
      "label": 3,
      "firstPortion": 2,
      "plausibleYear": 1,
      "dueLabel": -3,
      "birthLabel": -3,
      "crowdedLine": -1,
      "matchesMetadata": 1
