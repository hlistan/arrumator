    "firstPortionShare": 0.3,
    "crowdedLineDates": 3,
    "minTextDateScore": 1,
    "companySuffixes": [
      "ООО",
      "ОАО",
      "ЗАО",
      "АО",
      "ПАО",
      "ИП",
      "Lda",
