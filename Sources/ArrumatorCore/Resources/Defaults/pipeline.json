{
  "ollama": {
    "appBundleIdentifier": "com.electron.ollama",
    "appBinarySubpath": "Contents/Resources/ollama",
    "binarySearchPaths": [
      "/Applications/Ollama.app",
      "~/Applications/Ollama.app",
      "/opt/homebrew/bin/ollama",
      "/usr/local/bin/ollama"
    ],
    "serveEnvironment": {
      "OLLAMA_MAX_LOADED_MODELS": "2"
    },
    "timeouts": {
      "meta": 2,
      "version": 1.5,
      "chat": 180,
      "embed": 60,
      "pull": 0
    },
    "retryDelays": [
      2,
      8,
      30
    ],
    "healthPollStarting": 0.5,
    "healthPollSteady": 30,
    "startTimeout": 30,
    "restartBackoff": [
      5,
      30,
      120,
      600
    ],
    "maxRestartsPerHour": 5,
    "requiredFreeDiskGBAfterPull": 5
  },
  "modelProfiles": {
    "standard": {
      "label": "Standard (ministral-3:14b + bge-m3, ~10 GB)",
      "chatModel": "ministral-3:14b",
      "visionModel": "ministral-3:14b",
      "embedModel": "bge-m3",
      "fastModel": "ministral-3:14b",
      "numCtx": 12288,
      "fastNumCtx": 12288,
      "keepAliveChat": "10m",
      "keepAliveEmbed": "30m"
    },
    "balanced": {
      "label": "Balanced (ministral-3:8b + bge-m3, ~7 GB)",
      "chatModel": "ministral-3:8b",
      "visionModel": "ministral-3:8b",
      "embedModel": "bge-m3",
      "fastModel": "ministral-3:8b",
      "numCtx": 12288,
      "fastNumCtx": 12288,
      "keepAliveChat": "10m",
      "keepAliveEmbed": "30m"
    },
    "lowMemory": {
      "label": "Low memory (gemma4:e2b-it-qat + bge-m3, ~5.5 GB)",
      "chatModel": "gemma4:e2b-it-qat",
      "visionModel": "gemma4:e2b-it-qat",
      "embedModel": "bge-m3",
      "fastModel": "gemma4:e2b-it-qat",
      "numCtx": 12288,
      "fastNumCtx": 12288,
      "keepAliveChat": "10m",
      "keepAliveEmbed": "30m"
    }
  },
  "watcher": {
    "fsEventsLatency": 1.0,
    "stabilityPollInterval": 2.0,
    "stabilityRequiredPolls": 2,
    "zeroByteWaitSeconds": 30,
    "ignoredNamePrefixes": [
      ".",
      "~$",
      "._"
    ],
    "ignoredNames": [
      "Icon\r",
      ".DS_Store",
      "desktop.ini",
      "Thumbs.db"
    ],
    "ignoredExtensions": [
      "crdownload",
      "part",
      "download",
      "tmp",
      "partial",
      "opdownload"
    ],
    "ignoredNameSubstrings": [
      ".sb-",
      ".arrumator-tmp-"
    ],
    "managedFilePrefix": "_",
    "managedFileExtension": "md",
    "selfChangeTTLSeconds": 30
  },
  "records": {
    "documentsFileName": "_documents.md",
    "systemFolderName": "System",
    "historyFolderName": "History",
    "labelRulesFileName": "_labels.md",
    "setAsideSuffix": "unreadable"
  },
  "ingest": {
    "maxAttempts": 3,
    "retryDelays": [
      2,
      8,
      30
    ],
    "watchdogMinutes": 10
  },
  "extraction": {
    "ocrLanguages": [
      "en",
      "ru",
      "pt"
    ],
    "languageSampleChars": 4000,
    "languageMinConfidence": 0.5,
    "maxIndexChars": 200000,
    "largeFileBytes": 524288000,
    "perFileTimeout": 180,
    "toolTimeout": 30,
    "toolOutputCapBytes": 20971520,
    "plainTextReadCapBytes": 10485760,
    "pdf": {
      "textLayerHeadPages": 200,
      "textLayerTailPages": 5,
      "ocrHeadPages": 5,
      "ocrAllIfAtMost": 6,
      "ocrDPI": 200,
      "ocrDPILargePage": 150,
      "ocrDPISmallPage": 300,
      "largePageArea": 1400000,
      "smallPageArea": 87000,
      "minPageChars": 40,
      "minLetterShare": 0.35,
      "maxReplacementShare": 0.02,
      "imagePageMaxChars": 200,
      "orientationRetryBelowConfidence": 0.4,
      "ocrPageTimeout": 20,
      "fullPageImageCoverage": 0.85,
      "ocrMaxPixel": 5000
    },
    "image": {
      "ocrMaxPixel": 2048,
      "vlmMaxPixel": 1024,
      "jpegQuality": 0.8,
      "sparseChars": 80,
      "sparseWords": 8,
      "lowConfidence": 0.35,
      "vlmTimeout": 90
    },
    "ocr": {
      "lowConfidenceLine": 0.5,
      "lowConfidenceWarning": 0.4,
      "contrast": 1.3
    },
    "csvMaxRows": 200,
    "xlsx": {
      "maxSheets": 20,
      "maxRows": 300,
      "maxColumns": 30
    },
    "pptxMaxSlides": 100,
    "archiveMaxEntries": 200,
    "emailBodyCapBytes": 5242880,
    "quickLookPixel": 2048,
    "tableSnippetChars": 2000,
    "maxTables": 3,
    "candidateEncodings": [
      "utf8",
      "windowsCP1251",
      "koi8R",
      "macCyrillic",
      "isoLatin1",
      "windowsCP1252",
      "macOSRoman"
    ],
    "cyrillicBigramMinShare": 0.1,
    "toolKillGrace": 2,
    "zipEntryCapBytes": 20971520,
    "emailMaxPartDepth": 12,
    "tracePreviewChars": 200
  },
  "entities": {
    "dateLabels": [
      "date",
      "dated",
      "invoice date",
      "issue date",
      "issued",
      "data",
      "data de emissão",
      "emitido em",
      "data do documento",
      "дата",
      "дата документа",
      "дата выдачи",
      "от"
    ],
    "dueLabels": [
      "due",
      "due date",
      "pay by",
      "vencimento",
      "data limite",
      "pagar até",
      "data-limite",
      "срок оплаты",
      "оплатить до",
      "оплатить не позднее"
    ],
    "birthLabels": [
      "dob",
      "date of birth",
      "birth",
      "nascimento",
      "data de nascimento",
      "дата рождения"
    ],
    "labelWindowChars": 120,
    "yearsBack": 30,
    "yearsForward": 1,
    "scores": {
      "label": 3,
      "firstPortion": 2,
      "plausibleYear": 1,
      "dueLabel": -3,
      "birthLabel": -3,
      "crowdedLine": -1,
      "matchesMetadata": 1
    },
    "firstPortionShare": 0.3,
    "crowdedLineDates": 3,
    "minTextDateScore": 1
  },
  "analysis": {
    "promptVersion": 6,
    "excerptChars": 12000,
    "excerptTailDivisor": 6,
    "embeddingSummaryChars": 2000,
    "embeddingIdentifiersLimit": 6,
    "embeddingNumCtx": 2048,
    "llmOptions": {
      "temperature": 0,
      "topK": 1,
      "topP": 1,
      "numPredict": 600,
      "seed": 42
    },
    "vlmNumPredict": 300,
    "promptDatesLimit": 5,
    "promptIdentifiersLimit": 8,
    "repairAttempts": 1
  },
  "labels": {
    "maxPerKind": 5,
    "maxValueChars": 80,
    "vocabulary": {
      "kinds": {
        "sender": {
          "mergeSimilarity": 1,
          "suggestSimilarity": 0.85,
          "promptLimit": 40
        },
        "party": {
          "mergeSimilarity": 1,
          "suggestSimilarity": 0.9,
          "promptLimit": 20
        },
        "topic": {
          "mergeSimilarity": 0.96,
          "suggestSimilarity": 0.94,
          "promptLimit": 40
        },
        "object": {
          "mergeSimilarity": 1,
          "suggestSimilarity": 0.9,
          "promptLimit": 0
        },
        "reference": {
          "mergeSimilarity": 1,
          "suggestSimilarity": 1,
          "promptLimit": 0
        },
        "jurisdiction": {
          "mergeSimilarity": 0.96,
          "suggestSimilarity": 0.85,
          "promptLimit": 15
        }
      },
      "promptPreferred": 20,
      "promptUnwanted": 20,
      "suggestionLimit": 50
    }
  },
  "naming": {
    "maxChars": 120,
    "maxBytes": 250,
    "forbiddenCharacters": [
      "/",
      ":",
      "\\"
    ],
    "collisionFormat": " (%d)"
  },
  "search": {
    "rrfK": 60,
    "ftsCandidateLimit": 200,
    "resultLimit": 50,
    "minSemanticQueryChars": 3,
    "semanticMinSimilarity": 0.56,
    "queryCacheSize": 256,
    "bm25Weights": [
      3,
      1,
      4,
      3,
      3,
      3,
      4,
      4,
      3,
      2,
      2,
      2,
      3,
      2
    ],
    "snippetTokens": 24,
    "debounceMilliseconds": 150,
    "vectorSnippetChars": 200
  },
  "logging": {
    "keepDays": 14,
    "maxBytes": 209715200,
    "bufferLimit": 5000,
    "followInterval": 1
  },
  "power": {
    "pauseBelowBatteryPercent": 20,
    "pauseAtThermalState": "serious",
    "recheckSeconds": 60
  },
  "stats": {
    "windowsDays": [
      7,
      30,
      90
    ],
    "defaultWindowDays": 30,
    "diagnosticsTraceLimit": 200,
    "funnel": {
      "minimumForShares": 20,
      "steps": [
        {
          "id": "arrived",
          "title": "Arrived",
          "detail": "A new file settled in the Incoming folder.",
          "stages": [
            "hash"
          ],
          "logCategories": [
            "watch",
            "fileops"
          ],
          "jobStates": [
            "pending"
          ]
        },
        {
          "id": "deduplicated",
          "title": "Checked for copies",
          "detail": "Compared against everything already filed.",
          "stages": [
            "dedupe"
          ],
          "logCategories": [
            "ingest"
          ],
          "jobStates": [
            "hashing"
          ]
        },
        {
          "id": "read",
          "title": "Read",
          "detail": "Text pulled from the file, scanning pages when there is no text layer.",
          "stages": [
            "extract",
            "ocr",
            "vlm"
          ],
          "logCategories": [
            "extract"
          ],
          "jobStates": [
            "extracting"
          ]
        },
        {
          "id": "understood",
          "title": "Understood",
          "detail": "Dates and identifiers picked out of the text.",
          "stages": [
            "entities"
          ],
          "logCategories": [
            "extract"
          ],
          "jobStates": [
            "extracting"
          ]
        },
        {
          "id": "analysed",
          "title": "Analysed",
          "detail": "The local model read it and gave it its labels and its name, kept one vocabulary with the archive's.",
          "stages": [
            "analyse",
            "consolidate"
          ],
          "logCategories": [
            "ollama",
            "classify"
          ],
          "jobStates": [
            "analysing"
          ]
        },
        {
          "id": "filed",
          "title": "Filed",
          "detail": "Renamed, moved into the archive and added to the search index.",
          "stages": [
            "name",
            "place",
            "embed",
            "index"
          ],
          "logCategories": [
            "fileops",
            "index"
          ],
          "jobStates": [
            "filing"
          ]
        }
      ]
    }
  },
  "interface": {
    "recentlyProcessed": 8,
    "pageSize": 100,
    "sidebarLabelsPerKind": 8,
    "menuBarRecent": 5,
    "notificationEvents": 12,
    "extractPreviewChars": 2000
  },
  "maintenance": {
    "interval": 3600
  },
  "database": {
    "busyTimeout": 5
  }
}
