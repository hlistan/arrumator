# The tools the checks need: scripts/bootstrap.sh installs them here, and CI installs the same set.
brew "xcodegen"          # generates Arrumator.xcodeproj from project.yml
brew "swiftlint"         # Swift lint (.swiftlint.yml)
brew "periphery"         # unused code (.periphery.yml, scripts/deadcode.sh)
brew "gitleaks"          # secrets and signing material (.gitleaks.toml, scripts/check-secrets.sh)
brew "shellcheck"        # shell scripts and Git hooks
brew "actionlint"        # GitHub workflow syntax and the shell inside them
brew "zizmor"            # GitHub workflow security
brew "markdownlint-cli2" # documentation style (.markdownlint-cli2.jsonc)
brew "lychee"            # links and anchors between documents, checked offline
